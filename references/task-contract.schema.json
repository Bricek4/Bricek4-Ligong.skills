{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ligong/task-contract-v2.schema.json",
  "title": "Ligong TaskGuard v2 change contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id", "goal", "risk", "repo", "scope", "acceptance"],
  "properties": {
    "version": {"type": "integer", "const": 2},
    "task_id": {"$ref": "#/$defs/id"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
    "risk": {"enum": ["L0", "L1", "L2", "L3"]},
    "repo": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$"},
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repoRelativePath"}
    },
    "acknowledge_dirty": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repoRelativePathBelowRoot"}
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "$comment": "uniqueItems rejects identical duplicates; validate_contract additionally enforces unique id values across nonidentical objects.",
      "items": {"$ref": "#/$defs/acceptance"}
    },
    "forbidden": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "$comment": "validate_contract additionally enforces unique id values.",
      "items": {"$ref": "#/$defs/forbidden"}
    },
    "surfaces": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "$comment": "validate_contract additionally enforces unique id values and runtime path safety.",
      "items": {"$ref": "#/$defs/surface"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)[.][gG][iI][tT](?:/|$))[^\\u0000]+$"
    },
    "repoRelativePathBelowRoot": {
      "allOf": [
        {"$ref": "#/$defs/repoRelativePath"},
        {"not": {"const": "."}}
      ]
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[^\\u0000]+$"}
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "cwd", "requires_red", "idempotent"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "argv": {"$ref": "#/$defs/argv"},
        "cwd": {"$ref": "#/$defs/repoRelativePath"},
        "selector": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
        "requires_red": {"type": "boolean"},
        "expected_red_pattern": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
        "idempotent": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"requires_red": {"const": true}}, "required": ["requires_red"]},
          "then": {"required": ["expected_red_pattern"]}
        }
      ]
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "glob", "regex", "mode"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "glob": {"$ref": "#/$defs/repoRelativePathBelowRoot"},
        "regex": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "\\S"},
        "mode": {"enum": ["eliminate", "no_new"]}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "cwd", "read_only", "allowed_writes", "normalizer_version"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "argv": {"$ref": "#/$defs/argv"},
        "cwd": {"$ref": "#/$defs/repoRelativePath"},
        "read_only": {"type": "boolean", "const": true},
        "allowed_writes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repoRelativePathBelowRoot"}
        },
        "normalizer_version": {"enum": ["json-v1", "text-v1"]}
      }
    }
  }
}
