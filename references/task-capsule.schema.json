{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ligong/task-capsule-v1.schema.json",
  "title": "Ligong SSS task capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task_id",
    "outcome",
    "scope",
    "invariants",
    "evidence",
    "risk",
    "signals",
    "external_actions",
    "authority"
  ],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "outcome": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scope"}
    },
    "invariants": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "risk": {"enum": ["L0", "L1", "L2", "L3"]},
    "signals": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/signal"}
    },
    "authority": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/authority"}
    },
    "external_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/external_action"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.[gG][iI][tT](?:/|$)).*\\S.*$"
    },
    "l3_action": {
      "enum": [
        "deploy",
        "delete",
        "production_write",
        "third_party_write",
        "external_irreversible"
      ]
    },
    "external_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target", "environment", "scope"],
      "properties": {
        "action": {"$ref": "#/$defs/l3_action"},
        "target": {"$ref": "#/$defs/text"},
        "environment": {"$ref": "#/$defs/text"},
        "scope": {"$ref": "#/$defs/text"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action", "target", "environment", "scope", "task_id", "user_evidence"
      ],
      "properties": {
        "action": {"$ref": "#/$defs/l3_action"},
        "target": {"$ref": "#/$defs/text"},
        "environment": {"$ref": "#/$defs/text"},
        "scope": {"$ref": "#/$defs/text"},
        "task_id": {"$ref": "#/$defs/text"},
        "user_evidence": {"$ref": "#/$defs/text"}
      }
    },
    "signal": {
      "enum": [
        "public_api",
        "persistence",
        "migration",
        "identity",
        "authorization",
        "tenant",
        "privacy",
        "security",
        "data_loss",
        "false_supported",
        "ai_output",
        "deploy",
        "delete",
        "production_write",
        "third_party_write",
        "external_irreversible",
        "material_ambiguity",
        "multiple_owners",
        "dirty_overlap",
        "no_trusted_verification",
        "repeated_hypothesis_failure",
        "diff_expansion",
        "evidence_conflict",
        "evidence_staleness",
        "scope_expansion"
      ]
    }
  }
}
